# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.a
*.lib
*.pyd

# Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Preemptively ignore large checkpoints while preserving skeleton
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/**/.gitkeep

# Preemptively ignore raw large binaries or model weight files
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.tflite
*.ckpt

# Temporary / OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Scratch & local experimental scripts
scratch/
backup/
.agents/

# LaTeX build outputs and intermediate crops
pdf_pages/
pdf_pages_sec6/
pdf_qa_renders/
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Intermediate section PDFs and word docs
*.docx
Section_6_Methodology_Springer_Final.pdf
Section_7_8_Results_Conclusion_Springer_Final.pdf
Section_6_Methodology_Springer_Final.html
Section_7_8_Results_Conclusion_Springer_Final.html
paper_manuscript.html
